{
    "name": "Small Firewall",
    "vendor": "Juniper",
    "address": "10.52.46.19",
    "interfaces": [
        {
            "name": "Mgmt",
            "address": "10.52.43.90/29"
        },
        {
            "name": "eth1",
            "address": "192.168.202.252/24"
        },
        {
            "name": "eth3",
            "address": "192.168.203.254/24"
        }
    ],
    "services": [
        {
            "name": "ssh",
            "protocol": "TCP",
            "port": 22
        },
        {
            "name": "http",
            "protocol": "TCP",
            "port": 80
        },
        {
            "name": "https",
            "protocol": "TCP",
            "port": 443
        },
        {
            "name": "udp_all",
            "protocol": "UDP",
            "port": null
        }
    ],
    "service_groups": [
        {
            "name": "web",
            "services": ["http", "https"]
        }
    ],
    "hosts": [
        {
            "name": "Engineering-01",
            "address": "172.16.20.11/24",
            "zone": "Eng-Staff" 
        },
        {
            "name": "Engineering-02",
            "address": "172.16.20.12/24",
            "zone": "Eng-Staff" 
        },
        {
            "name": "Engineering-03",
            "address": "172.16.20.13/24",
            "zone": "Eng-Staff" 
        },
        {
            "name": "Engineering-04",
            "address": "172.16.20.14/24",
            "zone": "Eng-Staff" 
        },
        {
            "name": "FTP-Server",
            "address": "172.16.20.100/24",
            "zone": "Eng-Res" 
        },
        {
            "name": "Eng-DB",
            "address": "172.16.20.101/24",
            "zone": "Eng-Res" 
        },
        {
            "name": "Sales-01",
            "address": "172.16.10.11/24",
            "zone": "Sales" 
        },
        {
            "name": "Sales-02",
            "address": "172.16.10.12/24",
            "zone": "Sales" 
        },
        {
            "name": "HR-01",
            "address": "172.16.30.11/24"
        },
        {
            "name": "HR-02",
            "address": "172.16.30.12/24"
        },
        {
            "name": "HR-03",
            "address": "172.16.30.13/24"
        },
        {
            "name": "HR-Admin",
            "address": "172.16.30.10/24"
        },
        {
            "name": "HR-Apps",
            "address": "172.16.30.100/24"
        },
        {
            "name": "IT-Admin-01",
            "address": "172.16.0.3/24",
            "zone": "IT-Staff" 
        },
        {
            "name": "IT-Admin-02",
            "address": "172.16.0.14/24",
            "zone": "IT-Staff" 
        }
    ],
    "host_groups": [
        {
            "name": "Sales",
            "hosts": ["Sales-01", "Sales-02"]
        },
        {
            "name": "IT-Admin",
            "hosts": ["IT-Admin-01", "IT-Admin-02"]
        },
        {
            "name": "Engineering",
            "hosts": ["Engineering-01", "Engineering-02", "Engineering-03", "Engineering-04"]
        }
    ],
    "rules": [
        {
            "number": 1,
            "src": ["Engineering-01", "Engineering-02"],
            "dest": ["FTP-Server"],
            "services": ["TCP/21"]
        },
        {
            "number": 2,
            "src": ["Engineering-03", "Engineering-04"],
            "dest": ["Eng-DB"],
            "services": ["TCP/1521"]
        },
        {
            "number": 3,
            "src": ["HR-01", "HR-02","HR-03"],
            "dest": ["HR-Apps"],
            "services": ["web"]
        },
        {
            "number": 4,
            "src": ["HR-Admin"],
            "dest": ["HR-Apps"],
            "services": ["ssh", "web"]
        },
        {
            "number": 5,
            "src": ["IT-Admin"],
            "dest": ["Engineering", "HR-01", "HR-02","HR-03", "Sales"],
            "services": ["TCP/3389"]
        },
        {
            "number": 6,
            "src": ["IT-Admin-02"],
            "dest": ["Eng-DB"],
            "services": ["TCP/1521"]
        }
    ]
}